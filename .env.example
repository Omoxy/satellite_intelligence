# Satellite Intelligence Explorer — Environment Configuration
# Copy this file to .env and fill in values as needed.
# The application runs in demo mode by default (no external APIs required).

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,https://satelliteintelligence.netlify.app
ENVIRONMENT=development
# Leave blank for local loopback-only writes. Production requires a secret of at least 32 characters.
API_ACCESS_KEY=

# --- Database ---
DATABASE_PATH=./data/satellite_intelligence.db
RASTER_CACHE_DIR=./data/rasters

# --- Data Mode ---
# "demo" = deterministic demonstration data (default, no credentials needed)
# "live" = fetch real Sentinel-2 data (requires Sentinel Hub credentials below)
DATA_MODE=demo

# --- Sentinel Hub (required only when DATA_MODE=live) ---
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# --- Logging ---
LOG_LEVEL=INFO

# --- Limits ---
RATE_LIMIT_PER_MINUTE=60
MAX_AOI_AREA_SQ_KM=10000
MAX_REQUEST_SIZE_MB=10
